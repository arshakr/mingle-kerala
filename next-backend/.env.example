# Local development settings
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:8081
DATABASE_URL=
DIRECT_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
AUTH_SECRET=

# Production connection details belong in the hosting provider's secret settings.
# Use Neon pooled DATABASE_URL and direct DIRECT_URL connection strings.
# Create a Google App Password for SMTP_PASS (requires 2-Step Verification).
# EMAIL_FROM must use the same Gmail address as SMTP_USER.
# Use a random AUTH_SECRET of at least 32 bytes.
