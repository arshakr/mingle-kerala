# ── Mingle Kerala Backend — Environment Variables ────────────────────────────
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ── Database (Neon.tech PostgreSQL) ──────────────────────────────────────────
# Get this from: https://neon.tech → Your Project → Connection String
# Make sure to append ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
